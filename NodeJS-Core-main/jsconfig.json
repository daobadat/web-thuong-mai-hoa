{
   "compilerOptions": {
      "baseUrl": ".",
      "moduleResolution": "Node",
      "typeRoots": ["./node_modules/@types"],
      "skipLibCheck": true,
      "paths": {
         "modules/*": ["./modules/*"],
         "middlewares/*": ["./middlewares/*"],
         "config/*": ["./configs/*"],
         "database/*": ["./database/*"],
         "kernels/*": ["./kernels/*"],
         "models/*": ["./models/*"],
         "utils/*": ["./utils/*"]
      }
   },
   "include": ["./**/*"]
}
