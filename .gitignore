# ==========================================
# 1. Thư viện phụ thuộc (Dependencies)
# ==========================================
node_modules/
*/node_modules/

# ==========================================
# 2. File log & audit tự sinh khi chạy server
# ==========================================
logs/
*/logs/
*.log
*-audit.json
.*-audit.json
npm-debug.log*
yarn-debug.log*

# ==========================================
# 3. Môi trường & Bảo mật (Secrets)
# ==========================================
.env
.env.*
!.env.example
!.env.production.example

# ==========================================
# 4. File nén backup / deploy
# ==========================================
*.zip
*.rar
*.tar.gz
*.7z

# ==========================================
# 5. Build outputs từ Angular sang NodeJS public
# (Chỉ quản lý mã nguồn, không track file đã bundle)
# ==========================================
dist/
*/dist/
.angular/
NodeJS-Core-main/public/*.js
NodeJS-Core-main/public/*.css
NodeJS-Core-main/public/*.map
NodeJS-Core-main/public/index.html
NodeJS-Core-main/public/3rdpartylicenses.txt

# ==========================================
# 6. File tạm của hệ điều hành & IDE
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json